# HEXSign brand configuration — the one file a new deployment edits.
# Values below describe the CURRENT live platform. Change them, then run:
#   ./scripts/rebrand.sh          (rewrites the overlay to match this file)
#   ./scripts/apply.sh            (deploy to the containers)
#
# PRODUCT_NAME  : the platform brand shown across the UI (title, footer, emails)
# TENANT_NAME   : the business name on documents/certificates ("issued by ...")
# PLATFORM_URL  : public hostname, no scheme (used on certificates)
# SUPPORT_EMAIL : where bounces/spam reports and certificate contact go
# WEBSITE_URL   : the link in the footer
# CERT_LOGO     : file used as the certificate/PDF logo (relative to repo root)

PRODUCT_NAME="HexSign"
TENANT_NAME="Rapid Lodgements"
PLATFORM_URL="esign.rapidlodge.com.au"
SUPPORT_EMAIL="info@rapidlodge.com.au"
WEBSITE_URL="https://hexflow.com.au"
CERT_LOGO="assets/certificate-logo.png"
