# HEXSign / OpenSign stack environment — EXAMPLE ONLY.
# Copy to a private file (chmod 600) and fill in real values. Never commit real values.

# --- Parse application ---
APP_ID=opensign
MASTER_KEY=change-me-to-a-long-random-string
MONGODB_URI=mongodb://opensign-mongo:27017/opensign
PARSE_MOUNT=/app
SERVER_URL=http://opensign-server:8080/app

# --- Public URLs (client build) ---
PUBLIC_URL=https://sign.example.com
REACT_APP_APPID=opensign
REACT_APP_SERVERURL=https://sign.example.com/api/app
USE_LOCAL=false
GENERATE_SOURCEMAP=false
appName=HexSign

# --- Outgoing mail ---
SMTP_ENABLE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=sign@example.com
SMTP_PASS=change-me
SMTP_USER_EMAIL=sign@example.com

# --- Certificate signing (.p12 as base64) ---
PFX_BASE64=
PASS_PHRASE=

# --- Which images to run (public upstream by default) ---
# OPENSIGN_SERVER_IMAGE=opensign/opensignserver:main
# OPENSIGN_CLIENT_IMAGE=opensign/opensign:main
